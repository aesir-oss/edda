class KernelError(RuntimeError): ...
class NotFoundError(KernelError): ...
class InvalidRequestError(KernelError): ...
class ConflictError(InvalidRequestError): ...

class Kernel:
    def __init__(self, path: str) -> None: ...
    @property
    def title(self) -> str: ...
    def pages(self) -> str: ...
    def search(self, query: str, k: int = 10) -> str: ...
    def read_page(self, id: str, link_prefix: str = "/page/") -> str: ...
    def read_source(self, hash: str, start: int | None = None, end: int | None = None) -> str: ...
    def sources(self) -> str: ...
    def links(self, id: str) -> str: ...
    def propose_edit(self, job: str, page: str, base_rev: int, edits_json: str, rationale: str) -> str: ...
    def propose_page(
        self,
        job: str,
        page: str,
        kind: str,
        title: str,
        description: str,
        tags: list[str],
        body: str,
        rationale: str,
    ) -> str: ...
    def cite(self, proposal: str, claim: str, source: str, locator: str, source_id: str | None = None) -> str: ...
    def flag(self, job: str, page: str, kind: str, note: str) -> str: ...
    def accept(self, proposal: str, by: str = "owner") -> str: ...
    def reject(self, proposal: str, reason: str, by: str = "owner") -> str: ...
    def proposals(self) -> str: ...
    def proposal(self, id: str) -> str: ...
    def graph_issues(self) -> str: ...
    def history(self, id: str) -> str: ...
    def write_log(self) -> int: ...
    def verify_journal(self) -> int: ...
    def refresh_index(self, force: bool = False) -> None: ...

def okf_version() -> str: ...
