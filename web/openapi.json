                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/history/{page_id}": {
      "get": {
        "operationId": "history_api_history__page_id__get",
