{
  "components": {
    "schemas": {
      "AddedSource": {
        "description": "A source after an import; ``added`` is false when the same bytes were already stored.",
        "properties": {
          "added": {
            "title": "Added",
            "type": "boolean"
          },
          "source": {
            "$ref": "#/components/schemas/SourceSummary"
          }
        },
        "required": [
          "source",
          "added"
        ],
        "title": "AddedSource",
        "type": "object"
      },
      "BrokenLink": {
        "description": "A link to a page that does not exist.",
        "properties": {
          "dest": {
            "title": "Dest",
            "type": "string"
          },
          "from": {
            "title": "From",
            "type": "string"
          }
        },
        "required": [
          "from",
          "dest"
        ],
        "title": "BrokenLink",
        "type": "object"
      },
      "Citation": {
        "description": "A page's source, with the footnote that cites it and the raw file it resolves to.",
        "properties": {
          "cited": {
            "title": "Cited",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "raw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw"
          },
          "resource": {
            "title": "Resource",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "id",
          "resource",
          "cited"
        ],
        "title": "Citation",
        "type": "object"
      },
      "GraphIssues": {
        "description": "Pages nothing links to, and links to pages that do not exist.",
        "properties": {
          "broken_links": {
            "items": {
              "$ref": "#/components/schemas/BrokenLink"
            },
            "title": "Broken Links",
            "type": "array"
          },
          "orphans": {
            "items": {
              "type": "string"
            },
            "title": "Orphans",
            "type": "array"
          }
        },
        "required": [
          "orphans",
          "broken_links"
        ],
        "title": "GraphIssues",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "description": "Liveness.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "JournalEntry": {
        "description": "One recorded change to the vault.",
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "actor": {
            "title": "Actor",
            "type": "string"
          },
          "at": {
            "title": "At",
            "type": "string"
          },
          "data": {
            "title": "Data"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "page": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "prev": {
            "title": "Prev",
            "type": "string"
          },
          "rev": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rev"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "at",
          "actor",
          "action",
          "summary",
          "prev",
          "hash"
        ],
        "title": "JournalEntry",
        "type": "object"
      },
      "Links": {
        "description": "A page's outgoing links and the pages that link to it.",
        "properties": {
          "backlinks": {
            "items": {
              "type": "string"
            },
            "title": "Backlinks",
            "type": "array"
          },
          "outgoing": {
            "items": {
              "$ref": "#/components/schemas/OutLink"
            },
            "title": "Outgoing",
            "type": "array"
          }
        },
        "required": [
          "outgoing",
          "backlinks"
        ],
        "title": "Links",
        "type": "object"
      },
      "OutLink": {
        "description": "A link out of a page; ``target`` is the page id for links inside the bundle.",
        "properties": {
          "dest": {
            "title": "Dest",
            "type": "string"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          }
        },
        "required": [
          "dest"
        ],
        "title": "OutLink",
        "type": "object"
      },
      "Page": {
        "description": "A page: frontmatter, Markdown body, rendered HTML, revision and citations.",
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "frontmatter": {
            "additionalProperties": true,
            "title": "Frontmatter",
            "type": "object"
          },
          "html": {
            "title": "Html",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "title": "Issues",
            "type": "array"
          },
          "rev": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rev"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "frontmatter",
          "body",
          "html",
          "citations",
          "issues"
        ],
        "title": "Page",
        "type": "object"
      },
      "PageSummary": {
        "description": "A page as the Library lists it; ``sources`` are the hashes of the raw sources it cites.",
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          },
          "stale": {
            "default": false,
            "title": "Stale",
            "type": "boolean"
          },
          "stale_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stale After"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ],
        "title": "PageSummary",
        "type": "object"
      },
      "SearchHit": {
        "description": "One search result; ``snippet`` is escaped HTML with matches in ``<b>``.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "snippet": {
            "title": "Snippet",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "score",
          "snippet"
        ],
        "title": "SearchHit",
        "type": "object"
      },
      "Source": {
        "description": "The text of a raw source, or of a span of its lines.",
        "properties": {
          "added": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Added"
          },
          "driver": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Driver"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "hash",
          "text"
        ],
        "title": "Source",
        "type": "object"
      },
      "SourceSummary": {
        "description": "A raw source as the Library's source filter lists it.",
        "properties": {
          "added": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Added"
          },
          "driver": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Driver"
          },
          "hash": {
            "title": "Hash",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "hash"
        ],
        "title": "SourceSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VaultInfo": {
        "description": "What the shell shows about the open vault.",
        "properties": {
          "okf_version": {
            "title": "Okf Version",
            "type": "string"
          },
          "pages": {
            "title": "Pages",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "okf_version",
          "pages"
        ],
        "title": "VaultInfo",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Read-only access to an Edda vault: pages, search, sources and links.",
    "title": "Edda",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/graph/issues": {
      "get": {
        "operationId": "graph_issues_api_graph_issues_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphIssues"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Graph Issues",
        "tags": [
          "graph"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
