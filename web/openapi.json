            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sources",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/sources/markdown": {
      "post": {
        "description": "Stores the request body, a Markdown file, unedited as a raw source.",
        "operationId": "import_markdown_source_api_sources_markdown_post",
        "parameters": [
          {
            "description": "The file's name, the title of last resort",
            "in": "query",
            "name": "filename",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The file's name, the title of last resort",
              "title": "Filename"
            }
          },
          {
            "description": "Where the file came from, if anywhere",
            "in": "query",
            "name": "url",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where the file came from, if anywhere",
              "title": "Url"
            }
          },
          {
            "description": "Overrides the title read from the file",
            "in": "query",
            "name": "title",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Overrides the title read from the file",
              "title": "Title"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/markdown": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddedSource"
                }
              }
            },
            "description": "The same bytes were already stored"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddedSource"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
