            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Links",
        "tags": [
          "pages"
        ]
      }
    },
    "/api/pages": {
      "get": {
        "operationId": "list_pages_api_pages_get",
        "parameters": [
          {
            "description": "Only pages with this tag",
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only pages with this tag",
              "title": "Tag"
            }
          },
          {
            "description": "Only pages of this type",
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only pages of this type",
              "title": "Type"
            }
          },
          {
            "description": "Only pages citing this raw source (full hash or a prefix)",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only pages citing this raw source (full hash or a prefix)",
              "title": "Source"
            }
          },
          {
            "description": "Only pages with this status, such as draft",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only pages with this status, such as draft",
              "title": "Status"
            }
          },
          {
            "description": "Only pages past (or not past) stale_after",
            "in": "query",
            "name": "stale",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only pages past (or not past) stale_after",
              "title": "Stale"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PageSummary"
                  },
                  "title": "Response List Pages Api Pages Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Pages",
        "tags": [
          "pages"
        ]
      }
    },
    "/api/pages/{page_id}": {
      "get": {
        "operationId": "read_page_api_pages__page_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "page_id",
            "required": true,
            "schema": {
              "title": "Page Id",
              "type": "string"
